<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:gravity="center_horizontal" android:padding="28dp">
    <TextView android:id="@+id/victory_emblem" android:layout_width="80dp" android:layout_height="80dp"
        android:background="@drawable/bg_lime" android:text="@string/victory_star" android:textSize="48sp"
        android:textColor="@color/tile_ink" android:gravity="center" android:importantForAccessibility="no" />
    <TextView style="@style/Eyebrow" android:layout_marginTop="24dp" android:text="@string/victory_badge" android:textColor="@color/lime" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/victory_title" android:textSize="30sp" android:fontFamily="sans-serif-black" android:gravity="center" android:textColor="@color/white" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/victory_description" android:textSize="15sp" android:lineSpacingExtra="3dp" android:gravity="center" android:textColor="@color/muted" />
    <TextView android:id="@+id/victory_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:background="@drawable/bg_pill" android:padding="14dp" android:gravity="center" android:textColor="@color/white" android:textSize="14sp" />
    <Button android:id="@+id/victory_again" style="@style/ActionButton" android:layout_marginTop="24dp" android:text="@string/play_again" />
    <Button android:id="@+id/victory_home" style="@style/SecondaryButton" android:layout_marginTop="12dp" android:text="@string/return_home" />
</LinearLayout>
</ScrollView>
