<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_panel" android:padding="16dp" android:orientation="vertical">
    <TextView android:id="@+id/history_date" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="15sp"
        android:fontFamily="sans-serif-medium" android:textColor="@color/accent" />
    <TextView android:id="@+id/history_stats" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textSize="15sp" android:textColor="@color/white" />
</LinearLayout>
