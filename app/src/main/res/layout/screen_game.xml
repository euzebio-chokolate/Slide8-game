<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_screen" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:scrollbars="none" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:paddingTop="20dp" android:paddingBottom="28dp">
        <LinearLayout android:id="@+id/game_content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <Button android:id="@+id/back_home" style="@style/SecondaryButton" android:layout_width="48dp" android:layout_height="48dp"
                    android:minHeight="48dp" android:padding="0dp" android:text="@string/back_symbol" android:textSize="32sp" android:contentDescription="@string/back_home" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name"
                        android:textAllCaps="true" android:textSize="23sp" android:fontFamily="sans-serif-black" android:letterSpacing="0.08" android:textColor="@color/white" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/game_subtitle"
                        android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="3dp" />
                </LinearLayout>
                <TextView style="@style/Eyebrow" android:text="@string/board_size" android:background="@drawable/bg_pill"
                    android:padding="12dp" android:textColor="@color/accent" android:letterSpacing="0.05" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
                android:background="@drawable/bg_panel" android:padding="20dp" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView style="@style/Eyebrow" android:text="@string/time_label" />
                    <TextView android:id="@+id/timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="@string/timer_initial" android:textSize="30sp" android:textColor="@color/white"
                        android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" />
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="42dp" android:background="@color/border" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView style="@style/Eyebrow" android:text="@string/moves_label" />
                    <TextView android:id="@+id/moves" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="@string/moves_initial" android:textSize="30sp" android:textColor="@color/accent" android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:gravity="center_vertical">
                <TextView style="@style/Eyebrow" android:text="@string/goal_label" android:layout_width="0dp" android:layout_weight="1" android:textSize="11sp" />
                <TextView android:id="@+id/progress_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/accent" />
            </LinearLayout>
            <GridLayout android:id="@+id/board_grid" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/bg_board" android:padding="9dp" android:clipChildren="false"
                android:clipToPadding="false" android:columnCount="3" android:rowCount="3" android:layoutDirection="ltr"
                android:contentDescription="@string/board_description">
                <Button android:id="@+id/tile0" style="@style/PuzzleTile" />
                <Button android:id="@+id/tile1" style="@style/PuzzleTile" />
                <Button android:id="@+id/tile2" style="@style/PuzzleTile" />
                <Button android:id="@+id/tile3" style="@style/PuzzleTile" />
                <Button android:id="@+id/tile4" style="@style/PuzzleTile" />
                <Button android:id="@+id/tile5" style="@style/PuzzleTile" />
                <Button android:id="@+id/tile6" style="@style/PuzzleTile" />
                <Button android:id="@+id/tile7" style="@style/PuzzleTile" />
                <Button android:id="@+id/tile8" style="@style/PuzzleTile" />
            </GridLayout>
            <ProgressBar android:id="@+id/board_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="18dp"
                android:max="8" android:progressTint="@color/accent" android:progressBackgroundTint="@color/border" android:importantForAccessibility="no" />
            <TextView android:id="@+id/game_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:gravity="center" android:text="@string/game_hint" android:textColor="@color/muted"
                android:textSize="14sp" android:minLines="2" android:lineSpacingExtra="3dp" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
                <Button android:id="@+id/restart" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginEnd="6dp" android:text="@string/restart" />
                <Button android:id="@+id/pause_game" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginStart="6dp" android:text="@string/pause" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:baselineAligned="false">
                <Button android:id="@+id/game_theme" style="@style/SettingsButton"
                    android:layout_marginEnd="6dp" android:text="@string/theme_dark" />
                <Button android:id="@+id/game_sound" style="@style/SettingsButton"
                    android:layout_marginStart="6dp" android:text="@string/sound_on" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
