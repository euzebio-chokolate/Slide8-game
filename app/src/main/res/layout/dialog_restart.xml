<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/restart_scroll" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="28dp">
        <TextView android:layout_width="72dp" android:layout_height="72dp"
            android:background="@drawable/bg_lavender" android:text="@string/restart_symbol"
            android:textSize="44sp" android:textColor="@color/tile_ink" android:gravity="center"
            android:importantForAccessibility="no" />
        <TextView android:id="@+id/restart_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/restart_title" android:textSize="28sp"
            android:fontFamily="sans-serif-black" android:gravity="center" android:textColor="@color/white" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/restart_message" android:textSize="15sp"
            android:lineSpacingExtra="4dp" android:gravity="center" android:textColor="@color/muted" />
        <Button android:id="@+id/restart_confirm" style="@style/ActionButton"
            android:layout_marginTop="24dp" android:text="@string/restart_confirm" />
        <Button android:id="@+id/restart_cancel" style="@style/SecondaryButton"
            android:layout_marginTop="12dp" android:text="@string/cancel" />
    </LinearLayout>
</ScrollView>
