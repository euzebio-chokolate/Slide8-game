<resources>
    <style name="Theme.Slide8" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/lime</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="PuzzleTile" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">88dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">3dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/tile_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">38sp</item>
        <item name="android:saveEnabled">false</item>
    </style>
    <style name="ActionButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/tile_ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="SecondaryButton" parent="ActionButton">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="Eyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="PreviewTile">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_lavender</item>
        <item name="android:textColor">@color/tile_ink</item>
        <item name="android:textSize">27sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
